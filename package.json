{
  "name": "@cocreate/device",
  "version": "2.0.0",
  "description": "A shared device capability API and envelope bridge for CoCreate apps.",
  "keywords": [
    "device-api",
    "device-bridge",
    "browser-api",
    "low-code",
    "html5-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "device:android:setup": "bash scripts/android/setup-linux.sh",
    "device:android:build": "bash scripts/android/build.sh release",
    "device:android:build:debug": "bash scripts/android/build.sh debug",
    "device:ios:setup": "bash scripts/ios/setup.sh",
    "device:ios:build": "bash scripts/ios/build.sh archive",
    "device:ios:build:simulator": "bash scripts/ios/build.sh simulator",
    "device:ios:export": "bash scripts/ios/build.sh export",
    "device:windows:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/setup.ps1",
    "device:windows:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build.ps1 -Action Package",
    "device:windows:build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build.ps1 -Action Run -Configuration Debug",
    "test": "node --test test/*.test.mjs",
    "build:native": "webpack --mode=production --config webpack.config.js --env native=true",
    "device:prepare": "npm run build:native && node scripts/prepare.mjs",
    "device:prepare:assets": "node scripts/prepare.mjs",
    "device:android:doctor": "node scripts/doctor.mjs android",
    "device:ios:doctor": "node scripts/doctor.mjs ios",
    "device:windows:doctor": "node scripts/doctor.mjs windows"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/device.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/device/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/device",
  "main": "./src/index.js",
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "mini-css-extract-plugin": "^1.6.2",
    "webpack": "^5.108.4",
    "webpack-cli": "^4.10.0"
  },
  "allowScripts": {
    "@cocreate/webpack@1.9.0": true
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./native": "./src/native/index.js",
    "./native/runtime": "./src/native/runtime.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
